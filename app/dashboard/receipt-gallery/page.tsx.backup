
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { supabase } from "@/lib/supabase";

type LocationOption = {
  id: number;
  name: string;
};

type ExistingAttachment = {
  id: number;
  daily_record_id: number;
  original_file_name: string;
  storage_path: string;
  mime_type: string;
  file_size: number;
  created_at: string;
  daily_records: {
    transaction_no: string | null;
    record_date: string;
    payee: string;
    receipt_no: string | null;
    locations?: { name: string } | null;
  } | null;
};

type StandaloneReceipt = {
  id: number;
  location_id: number;
  receipt_no: string | null;
  receipt_date: string;
  payee: string;
  description: string | null;
  amount: number;
  remarks: string | null;
  original_file_name: string;
  storage_path: string;
  mime_type: string;
  file_size: number;
  created_at: string;
  locations?: { name: string } | null;
  file_url: string | null;
};

type GalleryItem = {
  id: string;
  kind: "daily" | "standalone";
  original_file_name: string;
  mime_type: string;
  file_size: number;
  created_at: string;
  date: string;
  locationName: string;
  transactionNo: string;
  payee: string;
  receiptNo: string;
  description: string;
  amount: number | null;
  remarks: string;
  signedUrl: string | null;
};

function formatDate(value: string) {
  if (!value) return "-";

  const date = new Date(`${value.slice(0, 10)}T00:00:00`);
  if (Number.isNaN(date.getTime())) return value;

  return new Intl.DateTimeFormat("en-PH", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(date);
}

function formatBytes(value: number) {
  if (value < 1024) return `${value} B`;
  if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)} KB`;
  return `${(value / (1024 * 1024)).toFixed(2)} MB`;
}

function peso(value: number) {
  return new Intl.NumberFormat("en-PH", {
    style: "currency",
    currency: "PHP",
  }).format(value);
}

export default function ReceiptGalleryPage() {
  const [items, setItems] = useState<GalleryItem[]>([]);
  const [locations, setLocations] = useState<LocationOption[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [errorMessage, setErrorMessage] = useState("");

  const [search, setSearch] = useState("");
  const [locationFilter, setLocationFilter] = useState("all");
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");
  const [typeFilter, setTypeFilter] = useState("all");

  const [locationId, setLocationId] = useState("");
  const [receiptNo, setReceiptNo] = useState("");
  const [receiptDate, setReceiptDate] = useState(
    new Date().toLocaleDateString("en-CA", {
      timeZone: "Asia/Manila",
    })
  );
  const [payee, setPayee] = useState("");
  const [description, setDescription] = useState("");
  const [amount, setAmount] = useState("");
  const [remarks, setRemarks] = useState("");
  const [file, setFile] = useState<File | null>(null);

  const getToken = useCallback(async () => {
    const {
      data: { session },
      error,
    } = await supabase.auth.getSession();

    if (error || !session?.access_token) {
      throw new Error("Your session has expired. Please log in again.");
    }

    return session.access_token;
  }, []);

  const loadGallery = useCallback(async () => {
    setLoading(true);
    setMessage("");
    setErrorMessage("");

    try {
      const token = await getToken();

      // Standalone receipts and locations are served by the protected API.
      const response = await fetch("/api/admin/standalone-receipts", {
        method: "GET",
        headers: { Authorization: `Bearer ${token}` },
        cache: "no-store",
      });

      const payload = await response.json();

      if (!response.ok || !payload.success) {
        throw new Error(payload.error || "Unable to load standalone receipts.");
      }

      const standalone: StandaloneReceipt[] = payload.receipts || [];
      const availableLocations: LocationOption[] = payload.locations || [];
      setLocations(availableLocations);

      const standaloneItems: GalleryItem[] = standalone.map((row) => ({
        id: `standalone-${row.id}`,
        kind: "standalone",
        original_file_name: row.original_file_name,
        mime_type: row.mime_type,
        file_size: Number(row.file_size || 0),
        created_at: row.created_at,
        date: row.receipt_date,
        locationName: row.locations?.name ||
          availableLocations.find((location) => location.id === row.location_id)?.name ||
          "Unknown location",
        transactionNo: "",
        payee: row.payee,
        receiptNo: row.receipt_no || "",
        description: row.description || "",
        amount: Number(row.amount || 0),
        remarks: row.remarks || "",
        signedUrl: row.file_url,
      }));

      // Keep the existing Daily Record attachment gallery.
      // These records are not copied into the standalone receipts table.
      const { data, error } = await supabase
        .from("daily_record_attachments")
        .select(`
          id,
          daily_record_id,
          original_file_name,
          storage_path,
          mime_type,
          file_size,
          created_at,
          daily_records (
            transaction_no,
            record_date,
            payee,
            receipt_no,
            locations ( name )
          )
        `)
        .order("created_at", { ascending: false });

      if (error) {
        console.error("Existing attachment load error:", error);
        setItems(standaloneItems);
        setErrorMessage(
          "Standalone receipts loaded, but existing Daily Record attachments could not be loaded. Check the existing attachment table permissions."
        );
        return;
      }

      const rows = (data || []) as unknown as ExistingAttachment[];

      const existingItems: GalleryItem[] = await Promise.all(
        rows.map(async (row) => {
          let signedUrl: string | null = null;

          // Existing attachments retain the current signed-URL behavior.
          const { data: signed, error: signedError } = await supabase.storage
            .from("daily-record-proofs")
            .createSignedUrl(row.storage_path, 300);

          if (signedError) {
            console.error("Existing attachment signed URL error:", signedError);
          } else {
            signedUrl = signed?.signedUrl || null;
          }

          return {
            id: `daily-${row.id}`,
            kind: "daily",
            original_file_name: row.original_file_name,
            mime_type: row.mime_type,
            file_size: Number(row.file_size || 0),
            created_at: row.created_at,
            date: row.daily_records?.record_date || row.created_at.slice(0, 10),
            locationName: row.daily_records?.locations?.name || "Unknown location",
            transactionNo: row.daily_records?.transaction_no || "",
            payee: row.daily_records?.payee || "",
            receiptNo: row.daily_records?.receipt_no || "",
            description: "",
            amount: null,
            remarks: "",
            signedUrl,
          };
        })
      );

      setItems([...standaloneItems, ...existingItems]);
    } catch (error) {
      console.error("Receipt Gallery load error:", error);
      setItems([]);
      setErrorMessage(
        error instanceof Error
          ? error.message
          : "An unexpected error occurred while loading receipts."
      );
    } finally {
      setLoading(false);
    }
  }, [getToken]);

  useEffect(() => {
    void loadGallery();
  }, [loadGallery]);

  const filteredItems = useMemo(() => {
    const term = search.trim().toLowerCase();

    return items.filter((item) => {
      const matchesSearch =
        !term ||
        [
          item.original_file_name,
          item.transactionNo,
          item.payee,
          item.receiptNo,
          item.locationName,
          item.description,
          item.remarks,
        ].some((value) => String(value || "").toLowerCase().includes(term));

      return (
        matchesSearch &&
        (locationFilter === "all" || item.locationName === locationFilter) &&
        (typeFilter === "all" || item.kind === typeFilter) &&
        (!dateFrom || item.date >= dateFrom) &&
        (!dateTo || item.date <= dateTo)
      );
    });
  }, [items, search, locationFilter, dateFrom, dateTo, typeFilter]);

  const groupedItems = useMemo(() => {
    return filteredItems.reduce<Record<string, GalleryItem[]>>((groups, item) => {
      (groups[item.locationName] ||= []).push(item);
      return groups;
    }, {});
  }, [filteredItems]);

  async function handleSave(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setMessage("");
    setErrorMessage("");

    if (!locationId) {
      setErrorMessage("Please select a project/location.");
      return;
    }

    if (!payee.trim()) {
      setErrorMessage("Please enter the payee.");
      return;
    }

    if (!receiptDate) {
      setErrorMessage("Please select the receipt date.");
      return;
    }

    if (amount.trim() === "" || !Number.isFinite(Number(amount)) || Number(amount) < 0) {
      setErrorMessage("Please enter a valid non-negative amount.");
      return;
    }

    if (!file) {
      setErrorMessage("Please choose a receipt photo.");
      return;
    }

    if (file.size <= 0 || file.size > 10 * 1024 * 1024) {
      setErrorMessage("The image must be greater than 0 and no larger than 10 MB.");
      return;
    }

    if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
      setErrorMessage("Only JPG, PNG, and WEBP images are allowed.");
      return;
    }

    setSaving(true);

    try {
      const token = await getToken();
      const formData = new FormData();

      formData.set("location_id", locationId);
      formData.set("receipt_no", receiptNo);
      formData.set("receipt_date", receiptDate);
      formData.set("payee", payee.trim());
      formData.set("description", description.trim());
      formData.set("amount", amount.trim());
      formData.set("remarks", remarks.trim());
      formData.set("file", file);

      const response = await fetch("/api/admin/standalone-receipts", {
        method: "POST",
        headers: { Authorization: `Bearer ${token}` },
        body: formData,
      });

      const payload = await response.json();

      if (!response.ok || !payload.success) {
        throw new Error(payload.error || "Unable to save receipt.");
      }

      setMessage("Receipt saved successfully.");
      setReceiptNo("");
      setPayee("");
      setDescription("");
      setAmount("");
      setRemarks("");
      setFile(null);

      const input = document.getElementById("receipt-image") as HTMLInputElement | null;
      if (input) input.value = "";

      await loadGallery();
    } catch (error) {
      console.error("Receipt save error:", error);
      setErrorMessage(
        error instanceof Error ? error.message : "An unexpected error occurred."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <main className="min-h-screen bg-slate-50 p-4 md:p-8">
      <div className="mx-auto max-w-7xl">
        <div className="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 className="text-3xl font-bold text-slate-900">
              Receipt / Proof Gallery
            </h1>
            <p className="mt-2 text-sm text-slate-500">
              Manage standalone receipts and attachments from saved Daily Records.
            </p>
          </div>

          <div className="flex flex-wrap gap-2">
            <a
              href="/dashboard"
              className="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100"
            >
              ← Back to Dashboard
            </a>
            <a
              href="/dashboard/daily-records"
              className="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700"
            >
              Back to Daily Records
            </a>
            <button
              type="button"
              onClick={() => void loadGallery()}
              disabled={loading || saving}
              className="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white disabled:opacity-50"
            >
              {loading ? "Refreshing..." : "Refresh"}
            </button>
          </div>
        </div>

        {message && (
          <div className="mb-5 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">
            {message}
          </div>
        )}

        {errorMessage && (
          <div className="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            {errorMessage}
          </div>
        )}

        <section className="mb-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div className="mb-5">
            <h2 className="text-xl font-bold text-slate-900">Add Standalone Receipt</h2>
            <p className="mt-1 text-sm text-slate-500">
              Save a receipt directly to a project without linking it to a Daily Record.
            </p>
          </div>

          <form onSubmit={handleSave} className="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
            <label className="text-sm font-semibold text-slate-700">
              Project / Location <span className="text-red-600">*</span>
              <select
                required
                value={locationId}
                onChange={(event) => setLocationId(event.target.value)}
                className="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"
              >
                <option value="">Select project/location</option>
                {locations.map((location) => (
                  <option key={location.id} value={location.id}>
                    {location.name}
                  </option>
                ))}
              </select>
            </label>

            <label className="text-sm font-semibold text-slate-700">
              Receipt Number
              <input
                value={receiptNo}
                onChange={(event) => setReceiptNo(event.target.value)}
                maxLength={120}
                placeholder="Enter receipt number"
                className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
              />
            </label>

            <label className="text-sm font-semibold text-slate-700">
              Receipt Date <span className="text-red-600">*</span>
              <input
                type="date"
                required
                value={receiptDate}
                onChange={(event) => setReceiptDate(event.target.value)}
                className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
              />
            </label>

            <label className="text-sm font-semibold text-slate-700">
              Payee <span className="text-red-600">*</span>
              <input
                required
                value={payee}
                onChange={(event) => setPayee(event.target.value)}
                maxLength={200}
                placeholder="Store, supplier, or person"
                className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
              />
            </label>

            <label className="text-sm font-semibold text-slate-700">
              Amount (PHP) <span className="text-red-600">*</span>
              <input
                required
                type="number"
                min="0"
                step="0.01"
                value={amount}
                onChange={(event) => setAmount(event.target.value)}
                placeholder="0.00"
                className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
              />
            </label>

            <label className="text-sm font-semibold text-slate-700">
              Description
              <input
                value={description}
                onChange={(event) => setDescription(event.target.value)}
                maxLength={500}
                placeholder="What was purchased?"
                className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
              />
            </label>

            <label className="text-sm font-semibold text-slate-700 md:col-span-2">
              Remarks
              <textarea
                value={remarks}
                onChange={(event) => setRemarks(event.target.value)}
                maxLength={1000}
                rows={2}
                placeholder="Optional notes"
                className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
              />
            </label>

            <label className="text-sm font-semibold text-slate-700">
              Receipt Photo <span className="text-red-600">*</span>
              <input
                id="receipt-image"
                type="file"
                required
                accept="image/jpeg,image/png,image/webp"
                onChange={(event) => setFile(event.target.files?.[0] || null)}
                className="mt-1 block w-full rounded-lg border border-slate-300 bg-white p-2 text-sm font-normal"
              />
              <span className="mt-1 block text-xs font-normal text-slate-500">
                JPG, PNG, or WEBP · Maximum 10 MB
              </span>
              {file && (
                <span className="mt-1 block break-words text-xs text-slate-600">
                  Selected: {file.name} ({formatBytes(file.size)})
                </span>
              )}
            </label>

            <div className="flex items-end md:col-span-2 xl:col-span-3">
              <button
                type="submit"
                disabled={saving || loading || locations.length === 0}
                className="w-full rounded-lg bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
              >
                {saving ? "Saving receipt..." : "Save Receipt"}
              </button>
            </div>
          </form>
        </section>

        <section className="mb-5 grid grid-cols-1 gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-2 xl:grid-cols-5">
          <label className="text-sm font-semibold text-slate-700">
            Search receipts
            <input
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Payee, receipt, file, project..."
              className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal outline-none focus:border-blue-500"
            />
          </label>

          <label className="text-sm font-semibold text-slate-700">
            Project / Location
            <select
              value={locationFilter}
              onChange={(event) => setLocationFilter(event.target.value)}
              className="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"
            >
              <option value="all">All projects</option>
              {Array.from(new Set(items.map((item) => item.locationName)))
                .sort()
                .map((name) => (
                  <option key={name} value={name}>{name}</option>
                ))}
            </select>
          </label>

          <label className="text-sm font-semibold text-slate-700">
            Receipt Type
            <select
              value={typeFilter}
              onChange={(event) => setTypeFilter(event.target.value)}
              className="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"
            >
              <option value="all">All receipts</option>
              <option value="standalone">Standalone receipts</option>
              <option value="daily">Daily Record attachments</option>
            </select>
          </label>

          <label className="text-sm font-semibold text-slate-700">
            From date
            <input
              type="date"
              value={dateFrom}
              onChange={(event) => setDateFrom(event.target.value)}
              className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
            />
          </label>

          <label className="text-sm font-semibold text-slate-700">
            To date
            <input
              type="date"
              value={dateTo}
              onChange={(event) => setDateTo(event.target.value)}
              className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"
            />
          </label>

          <div className="flex items-center justify-between gap-3 text-sm text-slate-500 md:col-span-2 xl:col-span-5">
            <span>
              {filteredItems.length} receipt(s) · {Object.keys(groupedItems).length} project/location(s)
            </span>
            <button
              type="button"
              onClick={() => {
                setSearch("");
                setLocationFilter("all");
                setDateFrom("");
                setDateTo("");
                setTypeFilter("all");
              }}
              className="rounded-lg border border-slate-300 px-3 py-2 font-semibold text-slate-700 hover:bg-slate-50"
            >
              Clear filters
            </button>
          </div>
        </section>

        {loading ? (
          <div className="rounded-2xl border bg-white p-12 text-center text-slate-500">
            Loading receipts...
          </div>
        ) : filteredItems.length === 0 ? (
          <div className="rounded-2xl border bg-white p-12 text-center">
            <div className="text-4xl">🧾</div>
            <h2 className="mt-3 font-bold text-slate-900">
              {items.length === 0 ? "No receipts yet" : "No receipts match these filters"}
            </h2>
            <p className="mt-2 text-sm text-slate-500">
              {items.length === 0
                ? "Add a standalone receipt above or attach a file to a saved Daily Record."
                : "Try another search term, project, receipt type, or date range."}
            </p>
          </div>
        ) : (
          <div className="space-y-8">
            {Object.entries(groupedItems).map(([locationName, locationItems]) => (
              <section key={locationName}>
                <div className="mb-3 flex items-center justify-between border-b border-slate-200 pb-2">
                  <h2 className="text-lg font-bold text-slate-900">📁 {locationName}</h2>
                  <span className="text-sm text-slate-500">
                    {locationItems.length} receipt(s)
                  </span>
                </div>

                <div className="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {locationItems.map((item) => (
                    <article
                      key={item.id}
                      className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
                    >
                      <div className="flex h-52 items-center justify-center overflow-hidden bg-slate-100">
                        {item.signedUrl && item.mime_type.startsWith("image/") ? (
                          <a
                            href={item.signedUrl}
                            target="_blank"
                            rel="noreferrer"
                            className="flex h-full w-full items-center justify-center"
                          >
                            <img
                              src={item.signedUrl}
                              alt={item.original_file_name}
                              className="max-h-full max-w-full object-contain"
                            />
                          </a>
                        ) : (
                          <div className="text-center">
                            <div className="text-5xl">🧾</div>
                            <p className="mt-2 text-sm font-semibold text-slate-600">
                              Receipt image unavailable
                            </p>
                          </div>
                        )}
                      </div>

                      <div className="space-y-3 p-5">
                        <div className="flex flex-wrap gap-2">
                          <span className={`rounded-full px-2.5 py-1 text-xs font-bold ${
                            item.kind === "standalone"
                              ? "bg-blue-100 text-blue-800"
                              : "bg-slate-100 text-slate-700"
                          }`}>
                            {item.kind === "standalone" ? "Standalone Receipt" : "Daily Record"}
                          </span>
                        </div>

                        <div>
                          <h3 className="break-words font-bold text-slate-900">
                            {item.original_file_name}
                          </h3>
                          <p className="mt-1 text-xs text-slate-500">
                            {formatBytes(item.file_size)} · Saved {formatDate(item.created_at)}
                          </p>
                        </div>

                        <div className="space-y-1 break-words text-sm">
                          <p>
                            <span className="text-slate-500">Receipt Date:</span>{" "}
                            {formatDate(item.date)}
                          </p>
                          <p>
                            <span className="text-slate-500">Payee:</span>{" "}
                            {item.payee || "-"}
                          </p>
                          <p>
                            <span className="text-slate-500">Receipt No.:</span>{" "}
                            {item.receiptNo || "-"}
                          </p>

                          {item.kind === "daily" && (
                            <p>
                              <span className="text-slate-500">Transaction:</span>{" "}
                              {item.transactionNo || "-"}
                            </p>
                          )}

                          {item.kind === "standalone" && (
                            <p>
                              <span className="text-slate-500">Amount:</span>{" "}
                              {peso(item.amount || 0)}
                            </p>
                          )}

                          {item.description && (
                            <p>
                              <span className="text-slate-500">Description:</span>{" "}
                              {item.description}
                            </p>
                          )}

                          {item.remarks && (
                            <p>
                              <span className="text-slate-500">Remarks:</span>{" "}
                              {item.remarks}
                            </p>
                          )}
                        </div>

                        {item.signedUrl ? (
                          <div className="flex gap-2 border-t pt-4">
                            <a
                              href={item.signedUrl}
                              target="_blank"
                              rel="noreferrer"
                              className="flex-1 rounded-lg bg-slate-900 px-3 py-2 text-center text-sm font-semibold text-white"
                            >
                              View
                            </a>
                            <a
                              href={item.signedUrl}
                              download={item.original_file_name}
                              className="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-center text-sm font-semibold text-slate-700"
                            >
                              Download
                            </a>
                          </div>
                        ) : (
                          <p className="border-t pt-3 text-xs text-red-600">
                            Unable to create a temporary file link. Refresh and try again.
                          </p>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>
    </main>
  );
}
