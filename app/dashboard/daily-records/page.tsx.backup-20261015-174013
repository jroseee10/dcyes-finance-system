
"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import { supabase } from "@/lib/supabase";
import ExcelJS from "exceljs";

type Location = {
  id: number;
  name: string;
  address: string | null;
};

type CurrentProfile = {
  id: number;
  name: string;
  email: string;
  position: string;
  status: string;
};

type FormItem = {
  key: string;
  id?: number;
  description: string;
  amount: string;
};

type SavedItem = {
  id: number;
  description: string;
  amount: number;
  item_order: number;
};

type DailyRecord = {
  id: number;
  transaction_no: string;
  record_date: string;
  payee: string;
  employee_name: string | null;
  receipt_no: string | null;
  address: string | null;
  remarks: string | null;
  location_id: number;
  destination: string;
  created_at: string;
  locations?: { name: string } | null;
  daily_record_items?: SavedItem[];
};

type SaveResponse = {
  success?: boolean;
  error?: string;
  record?: { id: number; transaction_no: string };
};

type UploadState = {
  busy: boolean;
  message: string;
  error: boolean;
};

const DESTINATIONS = [
  { value: "expenses", label: "Expenses" },
  { value: "liquidation", label: "Liquidation" },
  { value: "telegraphic_transfer", label: "Telegraphic Transfer" },
  { value: "deposit_slips", label: "Deposit Slips" },
];

const MAX_FILE_SIZE = 10 * 1024 * 1024;
const ALLOWED_TYPES = [
  "application/pdf",
  "image/jpeg",
  "image/png",
];

function createSubmissionKey() {
  return globalThis.crypto.randomUUID();
}

function createItem(): FormItem {
  return {
    key:
      globalThis.crypto?.randomUUID?.() ||
      `${Date.now()}-${Math.random()}`,
    description: "",
    amount: "",
  };
}

function getManilaDate() {
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Manila",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).formatToParts(new Date());

  const values = Object.fromEntries(
    parts.map((part) => [part.type, part.value])
  );

  return `${values.year}-${values.month}-${values.day}`;
}

function formatMoney(value: number) {
  return new Intl.NumberFormat("en-PH", {
    style: "currency",
    currency: "PHP",
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value || 0);
}

function formatDate(value: string) {
  if (!value) return "-";

  return new Intl.DateTimeFormat("en-PH", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date(`${value}T00:00:00`));
}

function destinationLabel(value: string) {
  return DESTINATIONS.find((item) => item.value === value)?.label || value;
}

export default function DailyRecordsPage() {
  const [profile, setProfile] = useState<CurrentProfile | null>(null);
  const [locations, setLocations] = useState<Location[]>([]);
  const [records, setRecords] = useState<DailyRecord[]>([]);
  const [loading, setLoading] = useState(true);
  const [loadingProfile, setLoadingProfile] = useState(true);
  const [saving, setSaving] = useState(false);
  const [editingRecordId, setEditingRecordId] = useState<number | null>(null);
  const [deletingRecordId, setDeletingRecordId] = useState<number | null>(null);
  const [reportPeriod, setReportPeriod] = useState<"daily" | "weekly" | "monthly">("daily");
  const [reportDate, setReportDate] = useState(getManilaDate());

  const [saveMessage, setSaveMessage] = useState("");
  const [saveMessageType, setSaveMessageType] =
    useState<"success" | "error" | "info">("info");

  const [submissionKey, setSubmissionKey] = useState(createSubmissionKey);
  const [date, setDate] = useState(getManilaDate());
  const [payee, setPayee] = useState("");
  const [employeeName, setEmployeeName] = useState("");
  const [receiptNo, setReceiptNo] = useState("");
  const [locationId, setLocationId] = useState("");
  const [address, setAddress] = useState("");
  const [destination, setDestination] = useState("expenses");
  const [remarks, setRemarks] = useState("");
  const [items, setItems] = useState<FormItem[]>([createItem()]);

  // Attachments selected before saving the record.
  const [pendingFiles, setPendingFiles] = useState<File[]>([]);
  const photoInputRef = useRef<HTMLInputElement | null>(null);
  const attachmentInputRef = useRef<HTMLInputElement | null>(null);

  const [uploadStates, setUploadStates] = useState<
    Record<number, UploadState>
  >({});

  const fileInputs = useRef<Record<number, HTMLInputElement | null>>({});

  const isAdmin =
    String(profile?.position || "").trim().toLowerCase() === "admin" &&
    String(profile?.status || "").trim().toLowerCase() === "active";

  const total = useMemo(
    () =>
      items.reduce((sum, item) => {
        const amount = Number(item.amount);
        return sum + (Number.isFinite(amount) ? amount : 0);
      }, 0),
    [items]
  );

  useEffect(() => {
    if (!locationId) {
      setAddress("");
      return;
    }

    const selectedLocation = locations.find(
      (location) => String(location.id) === locationId
    );

    if (selectedLocation) {
      setAddress(selectedLocation.address || "");
    }
  }, [locationId, locations]);

  async function loadProfile() {
    setLoadingProfile(true);

    try {
      const { data: authData, error: authError } =
        await supabase.auth.getUser();

      if (authError || !authData.user?.email) {
        setProfile(null);
        return;
      }

      const { data, error } = await supabase
        .from("users")
        .select("id, name, email, position, status")
        .eq("email", authData.user.email)
        .maybeSingle();

      if (error) {
        console.error("Daily Records profile error:", error);
        setProfile(null);
        return;
      }

      setProfile((data || null) as CurrentProfile | null);
    } catch (error) {
      console.error("Daily Records profile error:", error);
      setProfile(null);
    } finally {
      setLoadingProfile(false);
    }
  }

  async function loadLocations() {
    try {
      const { data, error } = await supabase
        .from("locations")
        .select("id, name, address")
        .order("name", { ascending: true });

      if (error) {
        console.error("Daily Records locations error:", error);
        setLocations([]);
        return;
      }

      setLocations((data || []) as Location[]);
    } catch (error) {
      console.error("Daily Records locations error:", error);
      setLocations([]);
    }
  }

  async function loadRecords() {
    setLoading(true);

    try {
      const { data, error } = await supabase
        .from("daily_records")
        .select(`
          id,
          transaction_no,
          record_date,
          payee,
          employee_name,
          receipt_no,
          address,
          remarks,
          location_id,
          destination,
          created_at,
          locations ( name ),
          daily_record_items (
            id,
            description,
            amount,
            item_order
          )
        `)
        .order("record_date", { ascending: false })
        .order("id", { ascending: false });

      if (error) {
        console.error("Daily Records load error:", error);
        setRecords([]);
        return;
      }

      setRecords((data || []) as unknown as DailyRecord[]);
    } catch (error) {
      console.error("Daily Records load error:", error);
      setRecords([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadProfile();
    void loadLocations();
    void loadRecords();
  }, []);

  function addPendingFiles(fileList: FileList | null) {
    if (!fileList) return;

    const incoming = Array.from(fileList);
    const accepted: File[] = [];
    const errors: string[] = [];

    for (const file of incoming) {
      if (!ALLOWED_TYPES.includes(file.type)) {
        errors.push(`${file.name}: PDF, JPG, or PNG files only.`);
        continue;
      }

      if (file.size <= 0 || file.size > MAX_FILE_SIZE) {
        errors.push(`${file.name}: file must be no larger than 10 MB.`);
        continue;
      }

      accepted.push(file);
    }

    setPendingFiles((current) => {
      const combined = [...current];

      for (const file of accepted) {
        const duplicate = combined.some(
          (existing) =>
            existing.name === file.name &&
            existing.size === file.size &&
            existing.lastModified === file.lastModified
        );

        if (!duplicate) combined.push(file);
      }

      if (combined.length > 10) {
        errors.push("You can attach a maximum of 10 files per record.");
        return combined.slice(0, 10);
      }

      return combined;
    });

    if (errors.length) {
      setSaveMessage(errors.join(" "));
      setSaveMessageType("error");
    } else {
      setSaveMessage("");
      setSaveMessageType("info");
    }

    // Allow selecting the same file again after removing it.
    if (photoInputRef.current) photoInputRef.current.value = "";
    if (attachmentInputRef.current) attachmentInputRef.current.value = "";
  }

  function removePendingFile(index: number) {
    setPendingFiles((current) =>
      current.filter((_, fileIndex) => fileIndex !== index)
    );
  }

  function clearForm() {
    if (saving) return;

    setEditingRecordId(null);
    setDate(getManilaDate());
    setPayee("");
    setEmployeeName("");
    setReceiptNo("");
    setLocationId("");
    setAddress("");
    setDestination("expenses");
    setRemarks("");
    setItems([createItem()]);
    setPendingFiles([]);
    setSubmissionKey(createSubmissionKey());
    setSaveMessage("");
    setSaveMessageType("info");

    if (photoInputRef.current) photoInputRef.current.value = "";
    if (attachmentInputRef.current) attachmentInputRef.current.value = "";
  }

  function updateItem(
    key: string,
    field: "description" | "amount",
    value: string
  ) {
    setItems((current) =>
      current.map((item) =>
        item.key === key ? { ...item, [field]: value } : item
      )
    );
  }

  function addItem() {
    if (items.length >= 100) {
      setSaveMessage("Maximum 100 items per record.");
      setSaveMessageType("error");
      return;
    }

    setItems((current) => [...current, createItem()]);
    setSaveMessage("");
  }

  function removeItem(key: string) {
    setItems((current) =>
      current.length <= 1
        ? current
        : current.filter((item) => item.key !== key)
    );
    setSaveMessage("");
  }

  function getRecordTotal(record: DailyRecord) {
    return (record.daily_record_items || []).reduce(
      (sum, item) => sum + Number(item.amount || 0),
      0
    );
  }

  async function handleSave() {
    if (saving) return;

    setSaveMessage("");
    setSaveMessageType("info");

    if (loadingProfile) {
      setSaveMessage("Please wait while your Admin profile is verified.");
      return;
    }

    if (!isAdmin) {
      setSaveMessage("An active Admin account is required to save records.");
      setSaveMessageType("error");
      return;
    }

    if (!date || !payee.trim() || !locationId) {
      setSaveMessage(
        "Please complete the date, payee, and project location."
      );
      setSaveMessageType("error");
      return;
    }

    if (address.length > 2000) {
      setSaveMessage("Address must not exceed 2,000 characters.");
      setSaveMessageType("error");
      return;
    }

    if (!DESTINATIONS.some((item) => item.value === destination)) {
      setSaveMessage("Please select a valid destination.");
      setSaveMessageType("error");
      return;
    }

    if (
      items.length === 0 ||
      items.length > 100 ||
      items.some(
        (item) =>
          !item.description.trim() ||
          item.amount.trim() === "" ||
          !Number.isFinite(Number(item.amount)) ||
          Number(item.amount) <= 0
      )
    ) {
      setSaveMessage(
        "Each item needs a description and an amount greater than zero. Maximum 100 items per record."
      );
      setSaveMessageType("error");
      return;
    }

    setSaving(true);

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError || !session?.access_token) {
        setSaveMessage(
          "Your login session is unavailable. Please log in again."
        );
        setSaveMessageType("error");
        return;
      }

      const response = await fetch("/api/admin/daily-records", {
        method: editingRecordId ? "PATCH" : "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({
          ...(editingRecordId ? { id: editingRecordId } : { submission_key: submissionKey }),
          record_date: date,
          payee: payee.trim(),
          employee_name: employeeName.trim(),
          receipt_no: receiptNo.trim(),
          address: address.trim(),
          remarks: remarks.trim(),
          location_id: Number(locationId),
          destination,
          items: items.map((item) => ({
            ...(item.id ? { id: item.id } : {}),
            description: item.description.trim(),
            amount: Number(item.amount),
          })),
        }),
      });

      const result = (await response.json()) as SaveResponse;

      if (!response.ok || !result.success || !result.record) {
        setSaveMessage(result.error || "Unable to save the Daily Record.");
        setSaveMessageType("error");
        return;
      }

      const savedRecord = result.record;
      const filesToUpload = [...pendingFiles];
      let uploadedCount = 0;
      const uploadErrors: string[] = [];

      // Upload selected attachments to the existing protected API.
      for (const file of filesToUpload) {
        try {
          const formData = new FormData();
          formData.append("daily_record_id", String(savedRecord.id));
          formData.append("file", file);

          const uploadResponse = await fetch(
            "/api/admin/daily-record-attachments",
            {
              method: "POST",
              headers: {
                Authorization: `Bearer ${session.access_token}`,
              },
              body: formData,
            }
          );

          const uploadResult = (await uploadResponse.json()) as {
            success?: boolean;
            error?: string;
          };

          if (!uploadResponse.ok || !uploadResult.success) {
            uploadErrors.push(
              `${file.name}: ${uploadResult.error || "Upload failed."}`
            );
          } else {
            uploadedCount += 1;
          }
        } catch (uploadError) {
          console.error("Attachment upload error:", uploadError);
          uploadErrors.push(`${file.name}: Upload failed.`);
        }
      }

      await loadRecords();

      setEditingRecordId(null);
      setDate(getManilaDate());
      setPayee("");
      setEmployeeName("");
      setReceiptNo("");
      setLocationId("");
      setAddress("");
      setDestination("expenses");
      setRemarks("");
      setItems([createItem()]);
      setSubmissionKey(createSubmissionKey());
      setPendingFiles([]);

      if (photoInputRef.current) photoInputRef.current.value = "";
      if (attachmentInputRef.current) attachmentInputRef.current.value = "";

      if (uploadErrors.length > 0) {
        setSaveMessage(
          `Daily Record ${savedRecord.transaction_no} was ${editingRecordId ? "updated" : "saved"}. ` +
            `${uploadedCount} of ${filesToUpload.length} attachment(s) uploaded. ` +
            `Failed: ${uploadErrors.join(" ")} ` +
            "Use the Receipt / Proof column below to retry failed uploads."
        );
        setSaveMessageType("error");
      } else {
        setSaveMessage(
          filesToUpload.length > 0
            ? `Daily Record ${savedRecord.transaction_no} ${editingRecordId ? "updated" : "saved"} successfully. All ${uploadedCount} attachment(s) uploaded.`
            : `Daily Record ${savedRecord.transaction_no} ${editingRecordId ? "updated" : "saved"} successfully.`
        );
        setSaveMessageType("success");
      }
    } catch (error) {
      console.error("Save Daily Record error:", error);
      setSaveMessage(
        "We could not confirm the result. Check the records list before retrying. Keep the same form values if retrying."
      );
      setSaveMessageType("error");
    } finally {
      setSaving(false);
    }
  }


  function beginEdit(record: DailyRecord) {
    if (!isAdmin) {
      setSaveMessage("An active Admin account is required to edit records.");
      setSaveMessageType("error");
      return;
    }

    setEditingRecordId(record.id);
    setDate(record.record_date);
    setPayee(record.payee || "");
    setEmployeeName(record.employee_name || "");
    setReceiptNo(record.receipt_no || "");
    setLocationId(String(record.location_id));
    setAddress(record.address || "");
    setDestination(record.destination || "expenses");
    setRemarks(record.remarks || "");
    const ordered = [...(record.daily_record_items || [])].sort(
      (a, b) => Number(a.item_order) - Number(b.item_order)
    );
    setItems(
      ordered.length
        ? ordered.map((item) => ({
            key: `existing-${item.id}`,
            id: item.id,
            description: item.description || "",
            amount: String(item.amount ?? ""),
          }))
        : [createItem()]
    );
    setPendingFiles([]);
    setSubmissionKey(createSubmissionKey());
    setSaveMessage(`Editing ${record.transaction_no}. Save changes using Update Daily Record.`);
    setSaveMessageType("info");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  async function deleteRecord(record: DailyRecord) {
    if (!isAdmin || deletingRecordId !== null) return;

    const confirmed = window.confirm(
      `Delete Daily Record ${record.transaction_no} for ${record.payee}?\n\nIts receipt attachments will also be removed from the Receipt / Proof Gallery. This cannot be undone.`
    );
    if (!confirmed) return;

    setDeletingRecordId(record.id);
    setSaveMessage("");
    try {
      const { data: { session }, error: sessionError } = await supabase.auth.getSession();
      if (sessionError || !session?.access_token) {
        throw new Error("Your login session is unavailable. Please log in again.");
      }

      const response = await fetch("/api/admin/daily-records", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ id: record.id }),
      });
      const result = (await response.json()) as { success?: boolean; error?: string };
      if (!response.ok || !result.success) {
        throw new Error(result.error || "Unable to delete this Daily Record.");
      }

      await loadRecords();
      setSaveMessage(`Daily Record ${record.transaction_no} was deleted.`);
      setSaveMessageType("success");
      if (editingRecordId === record.id) clearForm();
    } catch (error) {
      setSaveMessage(error instanceof Error ? error.message : "Unable to delete this Daily Record.");
      setSaveMessageType("error");
    } finally {
      setDeletingRecordId(null);
    }
  }

  function formatExcelDate(value: string) {
    const date = new Date(`${value.slice(0, 10)}T00:00:00`);
    if (Number.isNaN(date.getTime())) return value;
    const month = date.toLocaleString("en-US", { month: "short" }).toUpperCase();
    return `${month}-${String(date.getDate()).padStart(2, "0")}-${date.getFullYear()}`;
  }

  function formatTransactionNo(value: string) {
    const text = String(value || "");
    return /^\d+$/.test(text) ? text.padStart(4, "0") : text;
  }
  async function exportReport(
    sourceRecords: DailyRecord[],
    period: "daily" | "weekly" | "monthly",
    referenceDate: string
  ) {
    if (!referenceDate) {
      setSaveMessage("Choose a date for the report.");
      setSaveMessageType("error");
      return;
    }

    try {
      const selected = new Date(`${referenceDate.slice(0, 10)}T00:00:00`);

      if (Number.isNaN(selected.getTime())) {
        throw new Error("Invalid report date.");
      }

      let start = new Date(selected);
      let end = new Date(selected);

      if (period === "weekly") {
        const day = (selected.getDay() + 6) % 7;
        start.setDate(selected.getDate() - day);
        end = new Date(start);
        end.setDate(start.getDate() + 6);
      } else if (period === "monthly") {
        start = new Date(selected.getFullYear(), selected.getMonth(), 1);
        end = new Date(selected.getFullYear(), selected.getMonth() + 1, 0);
      }

      const toDateText = (value: Date) =>
        `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;

      const startText = toDateText(start);
      const endText = toDateText(end);

      const filtered = sourceRecords
        .filter(
          (record) =>
            record.record_date >= startText &&
            record.record_date <= endText
        )
        .sort(
          (a, b) =>
            a.record_date.localeCompare(b.record_date) ||
            a.transaction_no.localeCompare(b.transaction_no)
        );

      const summaryHeaders = [
        "Transaction No.",
        "Date",
        "Payee",
        "Employee Name",
        "Receipt No.",
        "Project Location",
        "Project Address",
        "Destination",
        "Remarks",
        "Total Amount",
        "Item Count",
      ];

      const detailHeaders = [
        "Transaction No.",
        "Date",
        "Payee",
        "Employee Name",
        "Receipt No.",
        "Project Location",
        "Project Address",
        "Destination",
        "Item Description",
        "Amount",
        "Remarks",
      ];

      const summaryRows: (string | number)[][] = filtered.map((record) => ({
        transactionNo: formatTransactionNo(record.transaction_no),
        date: formatExcelDate(record.record_date),
        payee: record.payee || "",
        employeeName: record.employee_name || "",
        receiptNo: record.receipt_no || "",
        location: record.locations?.name || "",
        address: record.address || "",
        destination: destinationLabel(record.destination),
        remarks: record.remarks || "",
        total: getRecordTotal(record),
        itemCount: (record.daily_record_items || []).length,
      })).map((record) => [
        record.transactionNo,
        record.date,
        record.payee,
        record.employeeName,
        record.receiptNo,
        record.location,
        record.address,
        record.destination,
        record.remarks,
        record.total,
        record.itemCount,
      ]);

      const detailRows: (string | number)[][] = filtered.flatMap((record) => {
        const orderedItems = [...(record.daily_record_items || [])].sort(
          (a, b) => Number(a.item_order) - Number(b.item_order)
        );

        return orderedItems.map((item) => [
          formatTransactionNo(record.transaction_no),
          formatExcelDate(record.record_date),
          record.payee || "",
          record.employee_name || "",
          record.receipt_no || "",
          record.locations?.name || "",
          record.address || "",
          destinationLabel(record.destination),
          item.description || "",
          Number(item.amount || 0),
          record.remarks || "",
        ]);
      });

      const summaryTotal = filtered.reduce(
        (sum, record) => sum + getRecordTotal(record),
        0
      );

      const detailTotal = detailRows.reduce(
        (sum, row) => sum + Number(row[9] || 0),
        0
      );

      const summaryItemCount = filtered.reduce(
        (sum, record) => sum + (record.daily_record_items || []).length,
        0
      );

      const workbook = new ExcelJS.Workbook();
      workbook.creator = "DCYES Finance Management System";
      workbook.subject = `${period} Daily Records Report`;
      workbook.title = `Daily Records ${period} Report`;
      workbook.created = new Date();
      workbook.modified = new Date();

      function buildSheet(
        name: string,
        headers: string[],
        rows: (string | number)[][],
        widths: number[],
        amountColumn: number,
        totalLabelColumn: number,
        totalAmount: number,
        totalCount?: number
      ) {
        const sheet = workbook.addWorksheet(name);

        sheet.columns = headers.map((header, index) => ({
          header,
          key: `column${index + 1}`,
          width: widths[index] || 18,
        }));

        sheet.mergeCells(1, 1, 1, headers.length);
        sheet.getCell(1, 1).value = "DCYES FINANCE MANAGEMENT SYSTEM";
        sheet.getCell(1, 1).font = {
          name: "Arial",
          size: 16,
          bold: true,
          color: { argb: "FFFFFFFF" },
        };
        sheet.getCell(1, 1).alignment = {
          vertical: "middle",
          horizontal: "center",
        };
        sheet.getCell(1, 1).fill = {
          type: "pattern",
          pattern: "solid",
          fgColor: { argb: "FF17365D" },
        };
        sheet.getRow(1).height = 30;

        sheet.mergeCells(2, 1, 2, headers.length);
        sheet.getCell(2, 1).value = name.toUpperCase();
        sheet.getCell(2, 1).font = {
          name: "Arial",
          size: 12,
          bold: true,
          color: { argb: "FF17365D" },
        };
        sheet.getCell(2, 1).alignment = { horizontal: "center" };
        sheet.getRow(2).height = 23;

        sheet.mergeCells(3, 1, 3, headers.length);
        sheet.getCell(3, 1).value =
          `Period: ${period.toUpperCase()} | ${startText} to ${endText}`;
        sheet.getCell(3, 1).font = {
          name: "Arial",
          size: 10,
          italic: true,
          color: { argb: "FF475569" },
        };
        sheet.getCell(3, 1).alignment = { horizontal: "center" };
        sheet.getRow(3).height = 21;

        sheet.addRow([]);
        const headerRow = sheet.addRow(headers);
        headerRow.height = 30;

        headerRow.eachCell((cell) => {
          cell.font = {
            name: "Arial",
            size: 10,
            bold: true,
            color: { argb: "FFFFFFFF" },
          };
          cell.fill = {
            type: "pattern",
            pattern: "solid",
            fgColor: { argb: "FF1F4E78" },
          };
          cell.alignment = {
            vertical: "middle",
            horizontal: "center",
            wrapText: true,
          };
          cell.border = {
            top: { style: "thin", color: { argb: "FFB4C6E7" } },
            bottom: { style: "thin", color: { argb: "FFB4C6E7" } },
            left: { style: "thin", color: { argb: "FFD9E2F3" } },
            right: { style: "thin", color: { argb: "FFD9E2F3" } },
          };
        });

        if (rows.length === 0) {
          const emptyRow = sheet.addRow(
            headers.map((_, index) =>
              index === totalLabelColumn - 1 ? "NO RECORDS" : ""
            )
          );
          emptyRow.font = {
            name: "Arial",
            size: 10,
            italic: true,
            color: { argb: "FF64748B" },
          };
        } else {
          rows.forEach((values, index) => {
            const row = sheet.addRow(values);
            row.height = 22;

            row.eachCell((cell, columnNumber) => {
              cell.font = { name: "Arial", size: 10 };
              cell.alignment = {
                vertical: "top",
                wrapText: true,
              };

              if (index % 2 === 1) {
                cell.fill = {
                  type: "pattern",
                  pattern: "solid",
                  fgColor: { argb: "FFF0F6FC" },
                };
              }

              cell.border = {
                bottom: {
                  style: "hair",
                  color: { argb: "FFD9E2F3" },
                },
              };

              if (columnNumber === amountColumn) {
                cell.numFmt = '"₱"#,##0.00;[Red]-"₱"#,##0.00';
                cell.alignment = {
                  vertical: "top",
                  horizontal: "right",
                };
              }
            });
          });

          const totalValues: (string | number)[] = headers.map(() => "");
          totalValues[totalLabelColumn - 1] = "OVERALL TOTAL";
          totalValues[amountColumn - 1] = Number(totalAmount.toFixed(2));

          if (typeof totalCount === "number") {
            totalValues[headers.length - 1] = totalCount;
          }

          const totalRow = sheet.addRow(totalValues);
          totalRow.height = 26;

          totalRow.eachCell((cell, columnNumber) => {
            cell.font = {
              name: "Arial",
              size: 10,
              bold: true,
              color: { argb: "FFFFFFFF" },
            };
            cell.fill = {
              type: "pattern",
              pattern: "solid",
              fgColor: { argb: "FF17365D" },
            };
            cell.border = {
              top: { style: "medium", color: { argb: "FF17365D" } },
            };

            if (columnNumber === amountColumn) {
              cell.numFmt = '"₱"#,##0.00;[Red]-"₱"#,##0.00';
              cell.alignment = { horizontal: "right" };
            }
          });
        }

        const lastRow = sheet.rowCount;
        const lastDataRow = Math.max(5, 4 + rows.length);

        sheet.autoFilter = {
          from: { row: 5, column: 1 },
          to: { row: lastDataRow, column: headers.length },
        };

        sheet.views = [
          {
            state: "frozen",
            xSplit: 0,
            ySplit: 5,
            showGridLines: false,
          },
        ];

        sheet.pageSetup = {
          paperSize: 9,
          orientation: "landscape",
          fitToPage: true,
          fitToWidth: 1,
          fitToHeight: 0,
          margins: {
            left: 0.25,
            right: 0.25,
            top: 0.5,
            bottom: 0.5,
            header: 0.2,
            footer: 0.2,
          },
        };

        sheet.pageSetup.printArea = `A1:${String.fromCharCode(64 + headers.length)}${lastRow}`;
        sheet.headerFooter.oddFooter =
          "&LDCYES Finance Management System&CPage &P of &N&RConfidential";

        return sheet;
      }

      buildSheet(
        "Transaction Summary",
        summaryHeaders,
        summaryRows,
        [18, 16, 25, 25, 18, 26, 36, 24, 32, 18, 13],
        10,
        9,
        summaryTotal,
        summaryItemCount
      );

      buildSheet(
        "Complete Item Details",
        detailHeaders,
        detailRows,
        [18, 16, 25, 25, 18, 26, 36, 24, 42, 18, 32],
        10,
        9,
        detailTotal
      );

      const buffer = await workbook.xlsx.writeBuffer();
      const blob = new Blob([buffer as BlobPart], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      const periodName = period[0].toUpperCase() + period.slice(1);

      link.href = url;
      link.download =
        `Daily-Records-${periodName}-${startText}-to-${endText}.xlsx`;

      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);

      setSaveMessage(
        `Exported ${filtered.length} transaction(s) for ${period.toLowerCase()} report (${startText} to ${endText}).`
      );
      setSaveMessageType("success");
    } catch (error) {
      console.error("Daily Records Excel export error:", error);
      setSaveMessage(
        error instanceof Error
          ? `Excel export failed: ${error.message}`
          : "Excel export failed. Please check the browser console."
      );
      setSaveMessageType("error");
    }
  }

  async function uploadReceipt(record: DailyRecord, file: File) {
    if (!isAdmin) {
      setUploadStates((current) => ({
        ...current,
        [record.id]: {
          busy: false,
          message: "Only an active Admin can upload attachments.",
          error: true,
        },
      }));
      return;
    }

    if (!ALLOWED_TYPES.includes(file.type)) {
      setUploadStates((current) => ({
        ...current,
        [record.id]: {
          busy: false,
          message: "Only PDF, JPG, and PNG files are accepted.",
          error: true,
        },
      }));
      return;
    }

    if (file.size <= 0 || file.size > MAX_FILE_SIZE) {
      setUploadStates((current) => ({
        ...current,
        [record.id]: {
          busy: false,
          message: "File must be greater than 0 and no larger than 10 MB.",
          error: true,
        },
      }));
      return;
    }

    setUploadStates((current) => ({
      ...current,
      [record.id]: {
        busy: true,
        message: "Uploading...",
        error: false,
      },
    }));

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError || !session?.access_token) {
        throw new Error("Login session expired. Please log in again.");
      }

      const formData = new FormData();
      formData.append("daily_record_id", String(record.id));
      formData.append("file", file);

      const response = await fetch("/api/admin/daily-record-attachments", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${session.access_token}`,
        },
        body: formData,
      });

      const result = (await response.json()) as {
        success?: boolean;
        error?: string;
      };

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Receipt upload failed.");
      }

      setUploadStates((current) => ({
        ...current,
        [record.id]: {
          busy: false,
          message: "Receipt uploaded successfully.",
          error: false,
        },
      }));

      if (fileInputs.current[record.id]) {
        fileInputs.current[record.id]!.value = "";
      }
    } catch (error) {
      console.error("Receipt upload error:", error);

      setUploadStates((current) => ({
        ...current,
        [record.id]: {
          busy: false,
          message:
            error instanceof Error
              ? error.message
              : "Receipt upload failed.",
          error: true,
        },
      }));
    }
  }

