                                "-"
                              )}
                            </td>

                            <td className="whitespace-nowrap px-4 py-4 text-right font-semibold">
                              {formatMoney(getRecordTotal(record))}
                            </td>

                            <td className="px-4 py-4">
                              {record.locations?.name || "-"}
                            </td>

                            <td className="max-w-[260px] whitespace-pre-wrap break-words px-4 py-4">
                              {record.address || "-"}
                            </td>

                            <td className="px-4 py-4">
                              {record.receipt_no || "-"}
                            </td>

                            <td className="px-4 py-4">
                              {record.employee_name || "-"}
                            </td>

                            <td className="px-4 py-4">
                              <span className="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold">
                                {destinationLabel(record.destination)}
                              </span>
                            </td>

                            <td className="max-w-[220px] whitespace-pre-wrap px-4 py-4">
                              {record.remarks || "-"}
                            </td>

                            <td className="min-w-[230px] px-4 py-4">
                              <input
                                ref={(element) => {
                                  fileInputs.current[record.id] = element;
                                }}
                                type="file"
                                accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"
                                disabled={!isAdmin || Boolean(uploadState?.busy)}
                                className="block w-full text-xs file:mr-2 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:font-semibold"
                                onChange={(event) => {
                                  const file = event.target.files?.[0];
                                  if (file) void uploadReceipt(record, file);
                                }}
                              />

                              {uploadState?.message && (
                                <p
                                  role="status"
                                  className={`mt-2 text-xs ${
                                    uploadState.error
                                      ? "text-red-600"
                                      : "text-green-700"
                                  }`}
                                >
                                  {uploadState.message}
                                </p>
                              )}

                              <a
                                href="/dashboard/receipt-gallery"
                                className="mt-2 inline-block text-xs font-semibold text-blue-700 underline"
                              >
                                Open Gallery
                              </a>
                            </td>
                            <td className="min-w-[150px] px-4 py-4">
                              <div className="flex flex-col gap-2">
                                <button
                                  type="button"
                                  disabled={!isAdmin || saving || deletingRecordId !== null}
                                  onClick={() => beginEdit(record)}
                                  className="rounded-md border border-blue-200 px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50 disabled:opacity-50"
                                >
                                  Edit
                                </button>
                                <button
                                  type="button"
                                  disabled={!isAdmin || saving || deletingRecordId !== null}
                                  onClick={() => void deleteRecord(record)}
                                  className="rounded-md border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50 disabled:opacity-50"
                                >
                                  {deletingRecordId === record.id ? "Deleting..." : "Delete"}
                                </button>
                              </div>
                            </td>
                          </tr>
                        );
                      })
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

